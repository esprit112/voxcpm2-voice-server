# VoxCPM2 Voice Server settings. Copy to .env (the installers do this for you) and edit.
# Real environment variables and command-line flags override this file.

# Network --------------------------------------------------------------------------------------
# 127.0.0.1 = this computer only (safest). 0.0.0.0 = reachable from your LAN (set an API key!).
VOXCPM_HOST=127.0.0.1
VOXCPM_PORT=8808
# Require "Authorization: Bearer <key>" on API calls. Empty = no key needed.
VOXCPM_API_KEY=
# Extra browser origins allowed to call the API (comma separated, or * for any). Localhost is always allowed.
VOXCPM_CORS_ORIGINS=

# Model & hardware -------------------------------------------------------------------------------
# auto picks CUDA (NVIDIA) -> MPS (Apple Silicon) -> CPU. Force with cuda, cuda:1, mps or cpu.
VOXCPM_DEVICE=auto
VOXCPM_MODEL_DIR=models/voxcpm2
# Download the weights automatically on first start if they are missing (1) or not (0).
VOXCPM_AUTO_DOWNLOAD=1
# torch.compile on NVIDIA GPUs: slower first start, faster speech afterwards. Needs Triton
# (Linux: included; Windows: pip install triton-windows). Falls back automatically if it fails.
VOXCPM_OPTIMIZE=0
# Load the model as soon as the server starts (1) or on the first request (0).
VOXCPM_PRELOAD=1

# Voices & quality -----------------------------------------------------------------------------
VOXCPM_DATA_DIR=data
VOXCPM_DEFAULT_VOICE=vox-aura-studio
# Diffusion steps (4-50): higher = slightly better, slower. 10 is a good balance.
VOXCPM_STEPS=10
# Guidance (1.0-5.0): how strongly the model follows the voice/style. 2.0 is the model default.
VOXCPM_CFG=2.0
# Long text is spoken in pieces of about this many characters (sentence boundaries are respected).
VOXCPM_MAX_CHARS_PER_PIECE=300
VOXCPM_MAX_INPUT_CHARS=20000

# Misc -----------------------------------------------------------------------------------------
# Show the model's per-step progress bars in the console (noisy).
VOXCPM_PROGRESS=0
# Apple Silicon: let unsupported Metal operations fall back to the CPU instead of failing.
PYTORCH_ENABLE_MPS_FALLBACK=1
# Use a Hugging Face mirror if huggingface.co is slow or blocked where you live, e.g. https://hf-mirror.com
# HF_ENDPOINT=
