# VoxCPM2 Voice Server - text-to-speech provider for Hermes Agent.
# Generated by integrations/hermes/install.py; re-run it to refresh the voice list.
manifest_version: 2
name: voxcpm2_server
label: "VoxCPM2 Voice Server"
version: "1.0.0"
description: "Private neural voices generated on this computer by the VoxCPM2 Voice Server (48 kHz, 30 languages, voice cloning). Pick the voice in the settings (gear)."
author: "VoxCPM2 Voice Server"
tags: [tts, voice, local, voxcpm2]
config_schema:
  voice:
    type: str
    label: "Voice"
    description: "The voice Hermes speaks with. Re-run the installer after creating new voices to refresh this list."
    choices: __VOICE_CHOICES__
    default: "__DEFAULT_VOICE__"
  emotion:
    type: str
    label: "Delivery"
    description: "Overall emotion. Inline markers such as [happy] or [whisper] in a reply still apply."
    choices: [neutral, cheerful, calm, empathetic, excited, authoritative, dramatic, whisper]
    default: neutral
  server_url:
    type: str
    label: "Server address"
    description: "Where the VoxCPM2 Voice Server is running."
    default: "__SERVER_URL__"
  auto_start:
    type: bool
    label: "Start the server automatically"
    description: "Starts the voice server in the background when speech is needed and it is not running."
    default: true
  server_folder:
    type: str
    label: "Server folder"
    description: "Where the VoxCPM2 Voice Server is installed (used to start it)."
    default: "__SERVER_FOLDER__"
  audio_format:
    type: str
    label: "Audio format"
    description: "Automatic uses the format Hermes asks for (normally MP3)."
    choices: [Automatic, MP3, FLAC, WAV, Opus]
    default: Automatic
  voice_messages:
    type: bool
    label: "Voice messages"
    description: "Deliver speech as Opus voice messages on Telegram and similar platforms."
    default: false
  timeout_seconds:
    type: int
    label: "Longest wait (seconds)"
    description: "How long Hermes waits for one piece of speech (includes model loading after a cold start)."
    default: 900
  api_key:
    type: secret
    env: VOXCPM_API_KEY
    label: "Server API key"
    description: "Leave empty unless the server was started with VOXCPM_API_KEY."
